#!/bin/bash

# omarchy:summary=Bring a window back from the Shelf onto the current workspace
# omarchy:args=<window-address>

ADDRESS=$1
[[ $ADDRESS =~ ^0x[0-9a-fA-F]+$ ]] || exit 1

SELECTOR="address:$ADDRESS"
RECORD_FILE="$XDG_RUNTIME_DIR/omarchy/shelf/$ADDRESS.json"

dispatch() {
  hyprctl dispatch "hl.dsp.$1" >/dev/null
}

client() {
  hyprctl clients -j | jq -c --arg address "$ADDRESS" 'first(.[] | select(.address == $address)) // empty'
}

CLIENT=$(client)
[[ -n $CLIENT && $(jq -r '.workspace.name' <<<"$CLIENT") == "special:shelf" ]] || exit 1

# A note left by a window that has since closed must not shape a new window that
# was given the same address.
RECORD=$(jq -c --argjson client "$CLIENT" 'select(.pid == $client.pid and .initialClass == $client.initialClass)' "$RECORD_FILE" 2>/dev/null)
RECORD=${RECORD:-"{}"}

# The window comes to the workspace in front of the user, which decides how it
# is arranged. Restoring while a special workspace is in front goes to the first.
read -r WORKSPACE_ID < <(hyprctl activeworkspace -j | jq -r '.id')
if [[ ! $WORKSPACE_ID =~ ^[0-9]+$ ]] || (( WORKSPACE_ID < 1 )); then
  WORKSPACE_ID=1
fi

DESTINATION_FLOATS=0
[[ $(omarchy-hyprland-workspace-layout-current "$WORKSPACE_ID") == "floating" ]] && DESTINATION_FLOATS=1

# A window that was floating before floating mode ever touched it -- a dialog,
# one popped out with Super + T -- floats wherever it goes.
FLOATS_ITSELF=$(jq -r 'if .floating and (.tags // [] | map(rtrimstr("*")) | index("omarchy-mode-floated") | not) then 1 else 0 end' <<<"$RECORD")

# The workspace mode would arrange the window as it arrives, before this has put
# it back where it was. The tag tells it to leave this one alone.
dispatch "window.tag({ tag = \"+omarchy-shelf-restoring\", window = \"$SELECTOR\" })"
trap 'dispatch "window.tag({ tag = \"-omarchy-shelf-restoring\", window = \"$SELECTOR\" })"' EXIT

dispatch "window.move({ workspace = \"$WORKSPACE_ID\", follow = true, window = \"$SELECTOR\" })"

if (( DESTINATION_FLOATS || FLOATS_ITSELF )); then
  if (( ! FLOATS_ITSELF )); then
    dispatch "window.tag({ tag = \"+omarchy-mode-floated\", window = \"$SELECTOR\" })"
  fi
  dispatch "window.float({ action = \"on\", window = \"$SELECTOR\" })"

  # Put it back where it was, relative to its monitor, but kept inside the one it
  # lands on now in case the displays changed while it was set aside.
  MONITOR=$(hyprctl monitors -j | jq -c --argjson id "$(client | jq '.monitor')" 'first(.[] | select(.id == $id)) // empty')
  GEOMETRY=$(jq -r --argjson monitor "${MONITOR:-null}" '
    if $monitor == null or .size == null then empty else
      ($monitor.width / $monitor.scale) as $w | ($monitor.height / $monitor.scale) as $h
      | (if ($monitor.transform // 0) % 2 == 1 then [$h, $w] else [$w, $h] end) as [$mw, $mh]
      | ($monitor.reserved // [0, 0, 0, 0]) as [$left, $top, $right, $bottom]
      | [$monitor.x + $left, $monitor.y + $top, $mw - $left - $right, $mh - $top - $bottom] as $area
      | (.monitorArea // $area) as $before
      | ([.size[0], $area[2] - 4] | min | floor) as $width
      | ([.size[1], $area[3] - 34] | min | floor) as $height
      | ([[.at[0] - $before[0] + $area[0], $area[0] + $area[2] - $width - 2] | min, $area[0] + 2] | max | floor) as $x
      | ([[.at[1] - $before[1] + $area[1], $area[1] + $area[3] - $height - 2] | min, $area[1] + 32] | max | floor) as $y
      | "\($width) \($height) \($x) \($y)"
    end' <<<"$RECORD")

  if [[ -n $GEOMETRY ]]; then
    read -r WIDTH HEIGHT X Y <<<"$GEOMETRY"
    dispatch "window.resize({ x = $WIDTH, y = $HEIGHT, relative = false, window = \"$SELECTOR\" })"
    dispatch "window.move({ x = $X, y = $Y, relative = false, window = \"$SELECTOR\" })"
  else
    dispatch "window.center({ window = \"$SELECTOR\" })"
  fi

  read -r FULLSCREEN FULLSCREEN_CLIENT PINNED < <(jq -r '"\(.fullscreen // 0) \(.fullscreenClient // 0) \(.pinned // false)"' <<<"$RECORD")
  if (( FULLSCREEN )); then
    dispatch "window.fullscreen_state({ internal = $FULLSCREEN, client = $FULLSCREEN_CLIENT, window = \"$SELECTOR\" })"
  fi
  if [[ $PINNED == "true" ]]; then
    dispatch "window.pin({ action = \"enable\", window = \"$SELECTOR\" })"
  fi
else
  # A tiled or scrolling workspace takes the window into its layout.
  dispatch "window.fullscreen_state({ internal = 0, client = 0, window = \"$SELECTOR\" })"
  dispatch "window.float({ action = \"off\", window = \"$SELECTOR\" })"
  dispatch "window.tag({ tag = \"-omarchy-mode-floated\", window = \"$SELECTOR\" })"
fi

if (( DESTINATION_FLOATS )); then
  dispatch "window.tag({ tag = \"+omarchy-floating-workspace\", window = \"$SELECTOR\" })"
else
  dispatch "window.tag({ tag = \"-omarchy-floating-workspace\", window = \"$SELECTOR\" })"
fi

dispatch "focus({ window = \"$SELECTOR\" })"
rm -f "$RECORD_FILE"
