#!/bin/bash

# omarchy:summary=Print the windows on the Shelf and the current workspace layout as JSON
# omarchy:hidden=true

SHELF_DIR="$XDG_RUNTIME_DIR/omarchy/shelf"
MODES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts"

read -r WORKSPACE_ID WORKSPACE_NAME < <(hyprctl activeworkspace -j | jq -r '"\(.id) \(.name)"')
LAYOUT=$(omarchy-hyprland-workspace-layout-current "$WORKSPACE_ID")

ALL_WORKSPACES=false
[[ -f $MODES_DIR/all.lua ]] && ALL_WORKSPACES=true

# Floating is in use once Float All Workspaces is on or any workspace floats,
# which is when the Shelf earns its place in the bar.
AVAILABLE=$ALL_WORKSPACES
grep -qs 'mode = "floating"' "$MODES_DIR"/*.lua && AVAILABLE=true

# Workspaces with a layout of their own while Float All Workspaces is on.
OVERRIDES=0
if [[ $ALL_WORKSPACES == "true" ]]; then
  OVERRIDES=$(find "$MODES_DIR" -maxdepth 1 -name '[0-9]*.lua' | wc -l)
fi

# Every window on the Shelf is listed, noted or not, so none can ever be left
# where nothing shows it.
RECORDS=$(cat "$SHELF_DIR"/*.json 2>/dev/null | jq -s 'map({ key: .address, value: . }) | from_entries')

hyprctl clients -j | jq -c \
  --argjson records "${RECORDS:-"{}"}" \
  --arg layout "$LAYOUT" \
  --arg workspace "$WORKSPACE_NAME" \
  --argjson all "$ALL_WORKSPACES" \
  --argjson available "$AVAILABLE" \
  --argjson overrides "$OVERRIDES" '
  {
    enabled: ($layout == "floating"),
    available: $available,
    allWorkspaces: $all,
    overrides: $overrides,
    layout: $layout,
    workspace: $workspace,
    windows: [
      .[] | select(.workspace.name == "special:shelf")
      | . as $client
      | ($records[.address] // {} | select(.pid == $client.pid and .initialClass == $client.initialClass) // {}) as $record
      | {
          address,
          title,
          class,
          workspace: ($record.workspace // ""),
          monitor: ($record.monitor // ""),
          order: ($record.order // 0)
        }
    ] | sort_by(-.order)
  }'
